{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run vercel-build",
  "regions": [
    "bom1"
  ],
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "45 18 * * *"
    }
  ]
}
