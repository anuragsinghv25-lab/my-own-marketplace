{
  "name": "orbita",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@orbita/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test && pnpm depcheck",
    "depcheck": "depcruise apps packages --config .dependency-cruiser.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @orbita/db run generate",
    "db:migrate": "pnpm --filter @orbita/db run migrate",
    "db:seed": "pnpm --filter @orbita/web run seed"
  },
  "devDependencies": {
    "dependency-cruiser": "^18.7.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~5.9.3"
  }
}
