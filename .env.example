# Copy to apps/web/.env.local for local development.
# On Vercel, connecting the Supabase integration fills in the Supabase and Postgres values for you.

# --- Supabase (Project Settings → API Keys / Data API) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=        # sb_publishable_… (or the legacy anon key)
SUPABASE_SECRET_KEY=                         # sb_secret_… (or the legacy service_role key). Server only, never NEXT_PUBLIC.

# --- Database (Project → Connect → ORMs / Transaction pooler, port 6543) ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Optional: session connection for migrations (port 5432). Derived from DATABASE_URL when unset.
# DATABASE_URL_DIRECT=

# --- App ---
APP_URL=http://localhost:3000               # public URL used in email links, e.g. https://orbita.inscapio.in
NEXT_PUBLIC_MARKETPLACE_NAME=Orbita
SETUP_TOKEN=change-me-to-a-long-random-string # needed once, to create the first platform admin at /setup
# NEXT_PUBLIC_DEMO_MODE=true                 # shows demo-account hints on the login page

# --- Email (optional until you want invites emailed) ---
# RESEND_API_KEY=
# EMAIL_FROM="Orbita <no-reply@inscapio.in>"

# --- Error tracking (optional) ---
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# --- Tests: a Postgres server URL; each run creates and drops its own database ---
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
